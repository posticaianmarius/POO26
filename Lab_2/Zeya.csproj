<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Zeya</RootNamespace>
    <AssemblyName>Zeya</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tokenizers.HuggingFace" Version="3.23.1" />
    <None Update="Chat/**/*.json;Chat/**/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../Lab_1/Logging/Logger.cs" Link="Logging/Logger.cs" />
    <Compile Include="../Lab_1/Logging/Formatter.cs" Link="Logging/Formatter.cs" />
    <Compile Include="../Lab_1/Logging/ConsoleSink.cs" Link="Logging/ConsoleSink.cs" />
  </ItemGroup>

</Project>
